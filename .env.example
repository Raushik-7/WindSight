# ---------------------------------------------------------------------------
# WindSight environment configuration
# Copy to `.env` and adjust. Only non-secret values live here; this application
# requires no API key for the Elexon BMRS endpoints it uses.
# ---------------------------------------------------------------------------

# --- Durable storage ------------------------------------------------------
# Local default: a SQLite file. In Docker the path must be inside the mounted
# volume (/app/data) so imported history survives restarts and rebuilds.
#   local:      sqlite:///data/windsight.db
#   docker:     sqlite:////app/data/windsight.db
#   production: postgresql://user:password@host:5432/windsight
#               (postgres:// and postgresql:// are normalised to psycopg 3)
# Leave empty locally to use the SQLite default. With ENVIRONMENT=production an
# empty value is a hard startup error instead of a silent local file.
DATABASE_URL=
# "development" (default) or "production". Production refuses to fall back to
# SQLite when DATABASE_URL is missing.
ENVIRONMENT=development
# Seed the database from the committed real Elexon snapshot when it is empty.
SEED_ON_STARTUP=true
# Shared secret for POST /api/refresh. Empty keeps the refresh endpoint disabled
# (the public demo is read-only); set it in production to allow operator refresh.
ADMIN_TOKEN=

# --- Upstream source ------------------------------------------------------
# Verified base URL from the official Elexon OpenAPI spec (data.elexon.co.uk).
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
# Seconds before a cached upstream fetch is refreshed.
CACHE_TTL_SECONDS=86400
# Request timeout / retry behaviour.
ELEXON_TIMEOUT_SECONDS=60
ELEXON_MAX_RETRIES=3
ELEXON_BACKOFF_SECONDS=1.5
# Maximum days per upstream request (bounded retrieval windows).
ELEXON_WINDOW_DAYS=15
# Set to false to serve only stored history (no outbound calls).
ENABLE_LIVE_FETCH=true
# Allow the committed snapshot to seed an empty database when the live API is
# unreachable. Provenance is always labelled in the UI.
ALLOW_SNAPSHOT_FALLBACK=true
# Days of forecast publication history imported before the evaluation period so
# early-January delivery days have eligible forecasts.
FORECAST_HISTORY_DAYS=30

# --- Evaluation period (delivery dates) ----------------------------------
EVAL_START=2026-01-01
EVAL_END=2026-01-31

# --- Decision cutoff policy (ANALYTICAL ASSUMPTION, not a market deadline) -
# cutoff = EVAL delivery date + DECISION_CUTOFF_DAY_OFFSET days, at
# DECISION_CUTOFF_HOUR:DECISION_CUTOFF_MINUTE in Europe/London.
DECISION_CUTOFF_HOUR=12
DECISION_CUTOFF_MINUTE=0
# -1 = day before the delivery date (default), 0 = the delivery date itself.
DECISION_CUTOFF_DAY_OFFSET=-1

# --- API ------------------------------------------------------------------
# Comma-separated allowed browser origins (CORS). In production set this to the
# deployed frontend origin, e.g. https://windsight.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
# Read-only demo by default: no authentication is enforced or required.
AUTH_ENABLED=false

# --- Frontend build (frontend/.env.local or Vercel project settings) -------
# Origin of the API when the frontend is hosted separately. Leave unset when
# nginx/Vite proxies /api on the same origin (Docker and local dev).
# VITE_API_BASE_URL=https://windsight-api.onrender.com
# Dev-server proxy target (npm run dev only).
# VITE_BACKEND_PROXY=http://localhost:8000

# --- Storage locations (defaults suit the container image) ----------------
# CACHE_DIR=/app/data/cache
# SNAPSHOT_DIR=/app/data/snapshots
